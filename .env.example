# Local backend. Set the HTTPS production API before building for deployment.
REACT_APP_API_URL=http://localhost:3007
REACT_APP_API_GRAPHQL_URL=http://localhost:3007/graphql
# Optional: defaults to the API origin with ws/wss protocol.
REACT_APP_API_WS=ws://localhost:3007

# Firebase public Web App configuration; enable only after backend/rules setup.
# Never put Firebase Admin service-account keys or backend secrets here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_APP_ID=
