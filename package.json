	"devDependencies": {
		"@types/apollo-upload-client": "^17.0.0",
		"@types/assert": "^1.5.6",
		"@types/node": "20.10.0",
		"@types/numeral": "^2.0.2",
		"@types/react": "18.2.0",
		"@types/react-dom": "18.2.7",
		"@types/react-icons": "^3.0.0",
		"eslint": "8.57.1",
		"eslint-config-next": "15.5.27",
		"jsdom": "26.1.0",
		"prettier": "2.7.1",
		"standard-version": "^9.5.0",
		"typescript": "4.9.5",
		"ws": "^8.21.0"
	},
	"resolutions": {
		"dompurify": "3.4.16",
