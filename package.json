{
	"name": "anorcar-next",
	"version": "2.2.0",
	"private": true,
	"license": "ITC",
	"scripts": {
		"dev": "next dev -p 3000",
		"build": "next build",
		"start": "next start",
		"lint": "eslint pages libs apollo --ext .ts,.tsx --max-warnings 0",
		"changelog": "standard-version --skip.tag",
		"typecheck": "tsc --noEmit --incremental false --noUnusedLocals --noUnusedParameters",
		"test:auth": "node scripts/check-auth-session.cjs",
		"test:chat": "node scripts/check-firebase-chat.cjs",
		"test:cache": "node scripts/check-apollo-cache.cjs && node scripts/check-like-updates.cjs",
		"test:migration": "node scripts/check-car-migration.cjs",
		"test:compare": "node scripts/check-car-compare.cjs && node scripts/check-compare-restoration.cjs",
		"check:graphql": "node scripts/check-graphql-contract.cjs",
		"test:articles": "node scripts/check-article-sanitizer.cjs",
		"test:seo": "node scripts/check-seo.cjs",
		"check:release": "yarn typecheck && yarn lint && yarn test:migration && yarn test:chat && yarn test:cache && yarn test:compare && yarn test:articles && yarn test:seo"
	},
	"dependencies": {
		"@apollo/client": "3.8.3",
