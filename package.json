		"axios": "0.34.0",
		"browser-image-compression": "^2.0.0",
		"dompurify": "3.4.16",
		"firebase": "^13.0.0",
		"graphql": "^16.8.1",
		"i18next": "23.4.6",
		"jwt-decode": "^3.1.2",
		"moment": "^2.29.3",
		"next": "15.5.27",
		"next-i18next": "^14.0.3",
		"numeral": "^2.0.6",
		"phosphor-react": "^1.4.1",
		"prop-types": "15.8.1",
		"react": "18.2.0",
		"react-dom": "18.2.0",
